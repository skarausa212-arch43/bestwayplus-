# LUMI per-instance environment.
# deploy.sh and auto-update.sh apply these as a systemd drop-in for the lumi
# service automatically — no manual server step. One KEY=VALUE per line.
#
# Admin allow-list: any account registering/logging in with one of these emails
# (comma-separated) is promoted to the admin role. Never put passwords here.
LUMI_ADMIN_EMAIL=skarausa212@gmail.com

# ── Domain / HTTPS ──
# Domain(s) this instance serves, comma-separated, NO spaces. auto-update.sh
# reconciles the Caddy reverse proxy to exactly these on every tick, and Caddy
# issues a Let's Encrypt certificate automatically for each one as soon as its
# DNS points at this server. To move to a new domain, edit this line and push —
# the running server picks it up within a few minutes, no manual server step.
LUMI_DOMAIN=lumi24.pl,lumi.bestwayplus.pl
# Canonical URL used in emails and OAuth redirects (should be the primary domain).
LUMI_APP_URL=https://lumi24.pl

# ── Email (transactional) ──
# System emails (welcome on sign-up, password reset, order updates) send through
# SMTP. Email stays OFF (safe no-op) until SMTP is configured.
#
# SECRETS DO NOT GO IN THIS FILE — it is tracked in git and overwritten by every
# code update. Put the whole SMTP block, including the password, in a server-only
# file the updater never touches:  deploy/instance.local.env  (see DEPLOY.md).
#
# Example for the GoDaddy Microsoft 365 mailbox support@lumi24.pl — put these in
# deploy/instance.local.env on the server, with the real password:
#   LUMI_SMTP_HOST=smtp.office365.com
#   LUMI_SMTP_PORT=587
#   LUMI_SMTP_USER=support@lumi24.pl
#   LUMI_SMTP_PASS=<mailbox password>
#   LUMI_MAIL_FROM=support@lumi24.pl        # M365 requires FROM == the signed-in user
#   LUMI_MAIL_FROM_NAME=LUMI
# NB: Microsoft 365 ships with "Authenticated SMTP" disabled — enable it for this
# mailbox in the Microsoft 365 admin center, or sending fails with 535 auth error.
# (LUMI_APP_URL is set above in the Domain / HTTPS section)

# ── AI calendar OCR (optional) ──
# The "import calendar from a photo" feature reads Airbnb/Booking screenshots.
# Without a key it falls back to parsing pasted TEXT (always works). Add a vision
# API key (OpenAI-compatible) to enable real screenshot OCR. Key is a SECRET —
# put it in deploy/instance.local.env on the server, not here.
#   LUMI_VISION_API_KEY=sk-...            # enables OCR
#   LUMI_VISION_URL=https://api.openai.com/v1/chat/completions   # default
#   LUMI_VISION_MODEL=gpt-4o-mini         # any vision-capable model

# ── Native push (Android + iOS via Firebase Cloud Messaging) ──
# Push stays OFF (safe no-op) until a Firebase service account is configured.
# RECOMMENDED: save the service-account JSON to a file on the server (the private
# key has spaces/newlines that don't survive a systemd env var) and point to it:
#   LUMI_FCM_KEY_FILE=/opt/lumi/deploy/fcm-service-account.json
# The file is server-only (never in git). See mobile/README.md for the steps.
# (Alternatively the three vars LUMI_FCM_PROJECT_ID / _CLIENT_EMAIL / _PRIVATE_KEY.)
# Extra API origins allowed cross-origin (native shells are allowed automatically):
#   LUMI_APP_ORIGINS=https://your-extra-origin

# ── Online payments (Przelewy24) ──
# Real card / BLIK / bank-transfer payments. OFF (safe no-op) until configured —
# the «Оплатить» button only appears when these are set. SECRETS go in the
# server-only file deploy/instance.local.env, NEVER here (this file is in git).
# From the P24 merchant panel (My data → API config):
#   LUMI_P24_MERCHANT_ID=123456
#   LUMI_P24_POS_ID=123456              # usually the same as the merchant id
#   LUMI_P24_API_KEY=<REST API key>     # → HTTP Basic auth (secret)
#   LUMI_P24_CRC=<CRC key>              # → request/notification signatures (secret)
#   LUMI_P24_SANDBOX=1                  # use the sandbox while testing; remove for production
# The notification (webhook) URL to register in the P24 panel is:
#   https://lumi24.pl/api/payments/p24/status

# Social sign-in — buttons appear only when configured (see DEPLOY.md → Social sign-in).
# Requires HTTPS + LUMI_APP_URL set. Secrets: server only, never commit real values.
#GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-google-client-secret
#APPLE_CLIENT_ID=pl.bestwayplus.lumi.web
#APPLE_TEAM_ID=XXXXXXXXXX
#APPLE_KEY_ID=YYYYYYYYYY
# Paste the full contents of the downloaded .p8 (the BEGIN/END PRIVATE KEY block),
# on one line with newlines written as \n. See DEPLOY.md → Social sign-in.
#APPLE_PRIVATE_KEY=
