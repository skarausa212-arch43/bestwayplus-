# LUMI per-instance environment.
# deploy.sh and auto-update.sh apply these as a systemd drop-in for the lumi
# service automatically — no manual server step. One KEY=VALUE per line.
#
# Admin allow-list: any account registering/logging in with one of these emails
# (comma-separated) is promoted to the admin role. Never put passwords here.
LUMI_ADMIN_EMAIL=skarausa212@gmail.com

# ── Email (transactional) ──
# Relay through a real SMTP server so system emails (welcome on sign-up, order
# updates) actually reach users. Leave blank to keep email OFF (safe no-op).
# Use your domain mailbox or a provider (Brevo, Mailgun, Amazon SES, Postmark…).
# The password/API key is a secret — set it here on the server only, never in git.
#LUMI_SMTP_HOST=smtp.your-provider.com
#LUMI_SMTP_PORT=587            # 587 = STARTTLS, 465 = implicit TLS
#LUMI_SMTP_USER=your-smtp-username
#LUMI_SMTP_PASS=your-smtp-password-or-api-key
#LUMI_MAIL_FROM=no-reply@bestwayplus.pl
#LUMI_MAIL_FROM_NAME=LUMI
#LUMI_APP_URL=https://lumi.bestwayplus.pl
