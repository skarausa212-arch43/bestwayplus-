# ───── Database (PostgreSQL 15+ or Supabase Postgres) ─────
# Runtime role used by the app. It is NOT the table owner, so Row Level Security applies to it.
DATABASE_URL=postgres://modu_app:change-me@localhost:5432/modu
# Owner role, used only by migrations and seed scripts (never by the running app).
DATABASE_ADMIN_URL=postgres://modu:change-me@localhost:5432/modu

# Public base URL — written into NFC tags. Use the final production domain before encoding tags!
APP_URL=http://localhost:3000

# Server-only secret (32+ chars). Used to HMAC activation codes, transfer codes, session tokens and IPs.
# Changing it invalidates all unused activation codes and all sessions. Generate: openssl rand -hex 32
SECRET_PEPPER=replace-with-64-random-hex-characters

# Shows demo tags / demo accounts hints. Set to "false" in production.
DEMO_MODE=true
# Force secure cookies (defaults to true when NODE_ENV=production)
# SECURE_COOKIES=true

# ───── Private file storage for MODU School evidence ─────
STORAGE_DRIVER=local            # local | supabase
STORAGE_LOCAL_DIR=.data/uploads
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # server-only, never exposed to the browser
# SUPABASE_STORAGE_BUCKET=school-evidence   # must be a PRIVATE bucket

# ───── Web3 (TESTNET ONLY, adults area) ─────
WEB3_CHAIN_ID=11155111          # Sepolia. 84532 = Base Sepolia, 31337 = local hardhat
# WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# MODU_TOKEN_ADDRESS=0x...       # from contracts/ deploy output
# MODU_CERTIFICATE_ADDRESS=0x...
# Server-only testnet minter key for certificates. Never put a mainnet key here.
# CERTIFICATE_MINTER_PRIVATE_KEY=0x...
