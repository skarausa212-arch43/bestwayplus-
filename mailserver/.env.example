# Скопируйте этот файл в .env и впишите свои значения.

# Ваш купленный домен (то, что после @ в адресах)
MAIL_DOMAIN=example.com

# Имя почтового сервера (на него нужна A-запись в DNS)
MAIL_HOSTNAME=mail.example.com

# Код приглашения для регистрации ящиков.
# Оставьте пустым — регистрация будет открыта для всех (не рекомендуется: спамеры найдут).
INVITE_CODE=

# Ссылка на веб-почту, показывается после успешной регистрации
WEBMAIL_URL=https://mail.example.com/webmail

# Токен телеграм-бота (@BotFather) для уведомлений о новых письмах.
# Пусто — кнопка Telegram в мульти-почте просто не показывается.
TELEGRAM_BOT_TOKEN=
