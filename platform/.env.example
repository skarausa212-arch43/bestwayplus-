# ---------------------------------------------------------------------------
# Bestway Football platform — copy to .env.local and fill in.
# Nothing in this file may be committed with real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# Postgres — EU region in every deployed environment
DATABASE_URL=postgresql://bwf:bwf@localhost:5432/bwf?schema=public

# Redis — queues and rate limiting
REDIS_URL=redis://localhost:6379

# Session and token signing. 32+ random bytes, rotated on a schedule.
AUTH_SECRET=
TOKEN_PEPPER=

# Private object storage. The bucket must have public access blocked.
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=bwf-documents-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# Transactional email
EMAIL_FROM="Bestway Football <no-reply@bestwayfootball.pl>"
EMAIL_API_KEY=

# Malware scanning (worker)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
