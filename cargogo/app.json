{
  "expo": {
    "name": "PakujGo",
    "slug": "pakujgo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "backgroundColor": "#F5F6F8", "resizeMode": "contain" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "pl.pakujgo.app" },
    "android": {
      "package": "pl.pakujgo.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0E1826" }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-location", "expo-notifications"]
  }
}
