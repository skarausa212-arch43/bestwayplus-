{
  "name": "chromecastinum",
  "productName": "Chromecastinum",
  "version": "1.0.0",
  "description": "Браузер для Windows, который никогда не сохраняет куки, историю и кэш на диск",
  "main": "main.js",
  "author": "bestwayplus",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "zipcodes": "^8.0.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bestwayplus.chromecastinum",
    "productName": "Chromecastinum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "Chromecastinum.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "build/icon.ico",
      "build/icon.png"
    ]
  }
}
